# =====================================================
# FLOWSTOCK - Variables de Entorno
# =====================================================
# COPIA este archivo y renómbralo a .env.local
# Luego llena los valores con tus datos de Supabase
# =====================================================

# Supabase URL (la encuentras en Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase Anon Key (la encuentras en Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
